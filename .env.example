# Chave compartilhada para autenticação HTTP (Authorization: Bearer ...).
# Gere uma chave com: openssl rand -hex 32
# Preencha no arquivo .env; nunca versione a chave real.
MEMPALACE_MCP_HTTP_TOKEN=

# Caminhos internos do container; manter alinhados ao volume de cache.
# Chroma usa Path.home()/.cache para os modelos ONNX.
HOME=/tmp
XDG_CACHE_HOME=/tmp/.cache
